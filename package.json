{
  "name": "hfrunner",
  "productName": "HF Runner",
  "version": "0.1.1",
  "description": "Find, download and run Hugging Face models on your own Windows PC (llama.cpp / Transformers / stable-diffusion.cpp)",
  "main": "./out/main/index.js",
  "author": "HF Runner",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:launcher": "node scripts/build-launcher.mjs",
    "dist:win": "npm run build:launcher && electron-vite build && electron-builder --win nsis zip --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
